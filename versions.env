# Single source of truth for tool versions.
# Used by: scripts/install-tools.sh (your laptop), Makefile, .github/workflows/ci.yml (CI).
# Change a version here, run `make tools`, and both your laptop and CI use the same binary.
HUGO_VERSION=0.167.0
PAGEFIND_VERSION=1.5.2

# SHA-256 of each release archive, copied from the projects' official checksum files.
# install-tools.sh refuses any download that doesn't match (ADR 0006).
# After changing a version above, run `make tool-hashes` and paste its output here.
HUGO_SHA256_AMD64=4d84519b9f619e6d4c3fb45a50157abeabeb724f859c60605f44c23def6e1169
HUGO_SHA256_ARM64=d0dd0d1ed249842525a93413e10ca1ef6f3b63311ee1695b16a0ce488142cec1
PAGEFIND_SHA256_X86_64=afb824a9e7f64905a934900481cea5be679c03975e527329e0e5e6cc70f5feda
PAGEFIND_SHA256_AARCH64=f50ec608bcbf431cebd84e0efa3a5b041ee63df2ad81f138023e0cfd2f509424
